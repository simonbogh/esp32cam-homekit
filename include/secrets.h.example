#pragma once
// Copy to include/secrets.h and fill in. The ESP32 only supports 2.4 GHz Wi-Fi.

#define WIFI_SSID "your-2.4GHz-ssid"
#define WIFI_PASS "your-password"

// HomeKit setup code, 8 digits. Avoid trivial codes (e.g. 12345678, 11111111): HomeSpan rejects them.
#define HK_PAIRING_CODE "20402210"
